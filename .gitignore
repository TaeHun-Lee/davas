# Dependencies
**/node_modules/

# Build, test, and tool caches
**/.next/
**/dist/
**/build/
**/out/
**/coverage/
**/.cache/
**/.turbo/
**/.parcel-cache/
**/.nyc_output/
**/playwright-report/
**/test-results/
*.tsbuildinfo
.eslintcache

# Local environment files (examples are source-controlled)
.env
.env.*
!.env.example
!.env.*.example
.envrc
!.envrc.example
**/.direnv/

# Logs and transient process state
**/logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.pid.lock

# Runtime user data and backup directories at any depth
**/uploads/
**/backups/
**/dumps/

# Database dumps and local database files
*.sql
*.dump
*.backup
*.bak
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Archives may contain uploads, dumps, credentials, or other sensitive runtime data
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.gz
*.bz2
*.xz
*.zst

# Explicit source fixtures remain trackable even when they use dump/archive extensions
!**/fixture/
!**/fixture/**
!**/fixtures/
!**/fixtures/**
!**/__fixtures__/
!**/__fixtures__/**

# OS/editor metadata
.DS_Store
Thumbs.db

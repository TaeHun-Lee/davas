{
  "name": "davas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.9 <21",
    "npm": ">=10 <11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "node scripts/run-tests.mjs",
    "test:shared": "node scripts/run-tests.mjs shared",
    "test:api": "node scripts/run-tests.mjs api",
    "test:web": "node scripts/run-tests.mjs web",
    "lint": "npm run lint --workspaces --if-present",
    "docs:check": "node scripts/verify-docs.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run docs:check && npm test && npm run lint && npm run build",
    "verify:release": "npm run verify && npm run audit:prod",
    "format": "prettier --write .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger@11.4.6": {
      "js-yaml": "5.2.2"
    },
    "multer": "2.2.0",
    "next@15.5.21": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    },
    "typeorm@0.3.31": {
      "glob": "13.0.6"
    }
  }
}

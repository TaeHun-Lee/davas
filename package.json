{
  "name": "davas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "node scripts/run-tests.mjs",
    "test:shared": "node scripts/run-tests.mjs shared",
    "test:api": "node scripts/run-tests.mjs api",
    "test:web": "node scripts/run-tests.mjs web",
    "lint": "npm run lint --workspaces --if-present",
    "docs:check": "node scripts/verify-docs.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run docs:check && npm test && npm run lint && npm run build",
    "verify:release": "npm run verify && npm run audit:prod",
    "format": "prettier --write .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}

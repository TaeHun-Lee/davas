DOMAIN=davas.duckdns.org
NEXT_PUBLIC_API_BASE_URL=https://davas.duckdns.org/api
CORS_ORIGINS=https://davas.duckdns.org

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=davas

JWT_ACCESS_SECRET=change-this-long-random-secret
JWT_ACCESS_EXPIRES_IN=7d
COOKIE_SECURE=true
TYPEORM_SYNC=false
TYPEORM_LOGGING=false

# First-account bootstrap only. Generate with: openssl rand -hex 16
# Leave empty to disable bootstrap signup. Remove these after the first invite has been consumed.
DAVAS_BOOTSTRAP_INVITE_CODE=
DAVAS_BOOTSTRAP_INVITE_MAX_USES=1
DAVAS_BOOTSTRAP_INVITE_EXPIRES_AT=2026-08-01T00:00:00Z

# Optional. Needed for TMDB-backed media search.
TMDB_API_KEY=

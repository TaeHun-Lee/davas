DOMAIN=davas.duckdns.org
NEXT_PUBLIC_API_BASE_URL=https://davas.duckdns.org/api

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=davas

JWT_ACCESS_SECRET=change-this-long-random-secret
TYPEORM_SYNC=false
TYPEORM_LOGGING=false

# First-account bootstrap only. Remove these after the first invite has been consumed.
DAVAS_BOOTSTRAP_INVITE_CODE=replace-with-a-one-time-code
DAVAS_BOOTSTRAP_INVITE_MAX_USES=1
DAVAS_BOOTSTRAP_INVITE_EXPIRES_AT=2026-08-01T00:00:00Z

# Optional. Needed for TMDB-backed media search/recommendations.
TMDB_API_KEY=

DOMAIN=davas.duckdns.org
NEXT_PUBLIC_API_BASE_URL=https://davas.duckdns.org/api
CORS_ORIGINS=https://davas.duckdns.org

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=davas

JWT_ACCESS_SECRET=change-this-long-random-secret
JWT_ACCESS_EXPIRES_IN=7d
COOKIE_SECURE=true
TYPEORM_SYNC=false
TYPEORM_LOGGING=false

# First-account bootstrap only. Generate with: openssl rand -hex 16
# Leave empty to disable bootstrap signup. Remove these after the first invite has been consumed.
DAVAS_BOOTSTRAP_INVITE_CODE=
DAVAS_BOOTSTRAP_INVITE_MAX_USES=1
# ISO date and time, e.g. 2026-12-31T00:00:00Z. Empty means 30 days after the API starts.
DAVAS_BOOTSTRAP_INVITE_EXPIRES_AT=

# Optional. Needed for TMDB-backed media search.
TMDB_API_KEY=

# Optional. KOFIC open API key (https://www.kobis.or.kr/kobisopenapi), used to link the films in
# theater showtimes to TMDB titles. Without it showtimes are still read but stay unlinked.
KOBIS_API_KEY=
# Optional. Leave empty to read Seoul and Gyeonggi showtimes from KOBIS daily at 12:00 KST; "off" stops it.
KOBIS_SHOWTIME_SYNC=

# Leave empty: production trusts exactly the one Caddy hop. Set only with another proxy in front.
TRUST_PROXY_HOPS=

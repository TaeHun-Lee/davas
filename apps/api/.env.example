DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=davas
TYPEORM_SYNC=true
TYPEORM_LOGGING=false
JWT_ACCESS_SECRET="replace-me-in-local-env-with-32-chars"
JWT_ACCESS_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SWAGGER_ENABLED=true
TMDB_API_KEY=""
PORT=4000

# Optional. A full connection URL used instead of the DB_* values above.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/davas
# Optional. Where uploads are stored (default: ./uploads).
# UPLOADS_DIR=
# Optional. Seeds a one-time sign-up code for the first account.
# DAVAS_BOOTSTRAP_INVITE_CODE=
# DAVAS_BOOTSTRAP_INVITE_MAX_USES=1
# DAVAS_BOOTSTRAP_INVITE_EXPIRES_AT=
# Optional. Proxy hops to trust for client IPs (production default: 1, local default: none).
# TRUST_PROXY_HOPS=
